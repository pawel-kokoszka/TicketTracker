@using TicketTracker.Application.Comments;
@model IEnumerable<HistoryItemDto>

<div>
    @{
        int commentNumber = 1;
    }

    <ul class="nav nav-pills mb-4 nav-justified shadow" id="pills-tab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link custom-pill active" id="pills-comments-tab" data-bs-toggle="pill" data-bs-target="#pills-comments" type="button" role="tab">User Comments</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link custom-pill" id="pills-history-tab" data-bs-toggle="pill" data-bs-target="#pills-history" type="button" role="tab">Ticket History</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link custom-pill" id="pills-combined-tab" data-bs-toggle="pill" data-bs-target="#pills-combined" type="button" role="tab">Combined View</button>
        </li>
    </ul>
    <div class="tab-content" id="pills-tabContent">
        <div class="tab-pane fade show active" id="pills-comments" role="tabpanel" tabindex="0">
            @foreach (var comment in Model)
            {
                <div class="card text-bg-primary mb-2" style="">
                    <div class="card-header pt-2 pb-1 ">

                        <div class="row">
                            <label class="col text-sm">#@commentNumber    @comment.CreatedDate </label>

                            <label class="col text-sm-end">Created by: @comment.UserName</label>
                        </div>

                    </div>

                    <div class="card-body  text-wrap text-break">

                        @Html.Raw(@comment.Message!.Replace("\n", "<br />"))

                    </div>
                </div>

                commentNumber++;
            }
        </div>
        <div class="tab-pane fade" id="pills-history" role="tabpanel" tabindex="0">...history...</div>
        <div class="tab-pane fade" id="pills-combined" role="tabpanel" tabindex="0">...comments and history...</div>
    </div>

</div>
