@using TicketTracker.Application.Comments;
@using TicketTracker.Application.HistoryItems;
@model IEnumerable<HistoryItemDto>

<div>
    @{
        int commentsNumberTabCombined, commentsNumberTabOnly; 
            commentsNumberTabCombined = commentsNumberTabOnly = Model.Count(historyItem => historyItem.ItemType == HistoryItem.Comment);
        
        int historyItemsNumberTabCombined, historyItemsNumberTabOnly;
            historyItemsNumberTabCombined = historyItemsNumberTabOnly = Model.Count(historyItem => historyItem.ItemType == HistoryItem.HistoryEvent);
    }

    <ul class="nav nav-pills mb-4 nav-justified shadow" id="pills-tab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link custom-pill active" id="pills-comments-tab" data-bs-toggle="pill" data-bs-target="#pills-comments" type="button" role="tab">User Comments</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link custom-pill" id="pills-history-tab" data-bs-toggle="pill" data-bs-target="#pills-history" type="button" role="tab">Ticket History</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link custom-pill" id="pills-combined-tab" data-bs-toggle="pill" data-bs-target="#pills-combined" type="button" role="tab">Combined View</button>
        </li>
    </ul>
    <div class="tab-content" id="pills-tabContent">
        <div class="tab-pane fade show active" id="pills-comments" role="tabpanel" tabindex="0">
            @foreach (var comment in Model)
            {
                @if (@comment.ItemType == HistoryItem.Comment) 
                {
                        <div class="card text-bg-info mb-3 ">
                            <div class="card-header pt-2 pb-1 ">

                                <div class="row">
                                <label class="col text-sm">#@commentsNumberTabOnly    @comment.CreatedDate </label>

                                    <label class="col text-sm-end">Created by: @comment.UserName</label>
                                </div>

                            </div>

                            <div class="card-body  text-wrap text-break">

                                @Html.Raw(@comment.Message!.Replace("\n", "<br />"))

                            </div>
                        </div>

                        commentsNumberTabOnly--;
                }
               
            }
        </div>
        <div class="tab-pane fade" id="pills-history" role="tabpanel" tabindex="0">
            @foreach (var comment in Model)
            {                
                @if (@comment.ItemType == HistoryItem.HistoryEvent)
                {
                    <div class="card text-bg-warning mb-3 ">
                        <div class="card-header pt-2 pb-1 ">

                            <div class="row">
                                <label class="col text-sm">#@historyItemsNumberTabOnly   @comment.CreatedDate </label>

                                <label class="col text-sm-end">Edited by: @comment.UserName</label>
                            </div>

                        </div>

                        <div class="card-body  text-wrap text-break">

                            @Html.Raw(@comment.Message!.Replace("\n", "<br />"))

                        </div>
                    </div>

                    historyItemsNumberTabOnly--;
                }
            }
        </div>
        <div class="tab-pane fade" id="pills-combined" role="tabpanel" tabindex="0">
            @foreach (var comment in Model)
            {
                @if (@comment.ItemType == HistoryItem.Comment)
                {
                    <div class="card text-bg-info mb-3 ">
                        <div class="card-header pt-2 pb-1 ">

                            <div class="row">
                                <label class="col text-sm">#@commentsNumberTabCombined    @comment.CreatedDate </label>

                                <label class="col text-sm-end">Created by: @comment.UserName</label>
                            </div>

                        </div>

                        <div class="card-body  text-wrap text-break">

                            @Html.Raw(@comment.Message!.Replace("\n", "<br />"))

                        </div>
                    </div>

                    commentsNumberTabCombined--;
                }
                @if (@comment.ItemType == HistoryItem.HistoryEvent)
                {
                    <div class="card text-bg-warning mb-3 ">
                        <div class="card-header pt-2 pb-1 ">

                            <div class="row">
                                <label class="col text-sm">#@historyItemsNumberTabCombined   @comment.CreatedDate </label>

                                <label class="col text-sm-end">Edited by: @comment.UserName</label>
                            </div>

                        </div>

                        <div class="card-body  text-wrap text-break">

                            @Html.Raw(@comment.Message!.Replace("\n", "<br />"))

                        </div>
                    </div>

                    historyItemsNumberTabCombined--;
                }
            }
        </div>
    </div>

</div>
